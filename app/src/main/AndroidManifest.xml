<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".FitnessBalanceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FitnessBalance"
        tools:targetApi="31">

        <!-- Firebase Authentication -->
        <meta-data
            android:name="firebase_auth_emulator_host"
            android:value="10.0.2.2:9099"
            tools:ignore="MissingClass" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            />
        <activity
            android:name=".RegistrationActivity"
            android:exported="false"
            />
        <activity
            android:name=".ForgetPasswordActivity"
            android:exported="false"
            />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            />
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".FoodLogActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".CalorieCalculatorActivity"
            android:parentActivityName=".FoodLogActivity" />

        <activity
            android:name=".ExerciseActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".FoodSearchActivity"
            android:exported="false" />

        <activity
            android:name=".FoodDetailsActivity"
            android:exported="false"
            android:parentActivityName=".FoodLogActivity" />

        <activity
            android:name=".CreateBarcodeFoodActivity"
            android:exported="false"
            android:parentActivityName=".FoodDetailsActivity" />

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

    <activity android:name=".PreferencesActivity" android:exported="false" />
    <activity android:name=".ui.exercise.ExerciseHomeActivity" android:exported="false" />
<activity android:name=".ui.exercise.WorkoutDetailsActivity" android:exported="false" />
<activity android:name=".ui.exercise.ActiveWorkoutActivity" android:exported="false" />
<activity android:name=".ui.exercise.WorkoutFeedbackActivity" android:exported="false" />
<activity android:name=".ui.exercise.WorkoutResultActivity" android:exported="false" />
    <activity android:name=".ui.exercise.WorkoutPathActivity" android:exported="false" />
    <activity android:name=".ui.exercise.ExerciseProgressActivity" android:exported="false" />
<activity android:name=".ui.exercise.AchievementsActivity" android:exported="false" />
    </application>



</manifest>