<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exercise_selection_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/runningCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_running"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cyclingCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_cycling"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/swimmingCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_swimming"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/weightliftingCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_weight_lifting"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/yogaCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_yoga"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/pilatesCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_pilates"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/basketballCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_basketball"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/footballCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_football"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/tennisCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_tennis"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/hiitCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_hiit"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/dancingCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_dancing"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/hikingCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_hiking"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/cancelSelectionButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:backgroundTint="#666666"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/saveSelectionButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/save"
            android:textSize="14sp"
            android:backgroundTint="#45B7D1"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>