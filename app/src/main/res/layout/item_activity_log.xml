<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/exercise_card_spacing"
    app:cardCornerRadius="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/alRowSource"
            style="@style/ExerciseBody"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/alRowName"
            style="@style/ExerciseHeading" />
        <TextView
            android:id="@+id/alRowDetails"
            style="@style/ExerciseBody" />
        <TextView
            android:id="@+id/alRowState"
            style="@style/ExerciseBody" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/alRowEdit"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/al_edit" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/alRowDelete"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/al_delete" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/alRowView"
            style="@style/ExerciseButton"
            android:text="@string/al_view" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
