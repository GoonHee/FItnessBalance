<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gm_canvas">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/exToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/back"
        app:title="@string/ex_home" app:titleTextColor="@color/gm_ink" android:background="@color/gm_canvas" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/exercise_spacing">
            <ProgressBar
                android:id="@+id/exLoading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/ex_loading"
                android:visibility="gone" />
            <TextView
                android:id="@+id/exStatus"
                style="@style/RewardBody"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/exRetry"
                style="@style/ExerciseButton"
                android:text="@string/ex_retry" />
            <LinearLayout
                android:id="@+id/exContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/exHello"
                    style="@style/RewardHeading" />
                <LinearLayout style="@style/RewardPanel" android:background="@drawable/reward_panel_xp">
                    <TextView style="@style/RewardBody" android:textColor="#FFFFFFFF" android:text="@string/gm_your_progress" />
                    <TextView
                        android:id="@+id/exLevel"
                        style="@style/RewardHeading" android:textColor="#FFFFFFFF" />
                    <TextView
                        android:id="@+id/exXp"
                        style="@style/RewardBody" android:textColor="#FFFFFFFF" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/exXpBar" app:indicatorColor="@color/gm_gold" app:trackColor="@color/gm_track" app:trackThickness="8dp" app:trackCornerRadius="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp"
                        android:max="100" />
                    <TextView
                        android:id="@+id/exApplicationProgress"
                        style="@style/RewardBody" android:textColor="#FFFFFFFF"
                        android:text="@string/ex_app_progress" />
                </LinearLayout>
                <LinearLayout style="@style/RewardPanel" android:background="@drawable/reward_panel_teal">
                    <TextView
                        android:id="@+id/exWeekly"
                        style="@style/RewardHeading"
                        android:text="@string/gm_week" />
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/exWeeklyRing" android:layout_width="96dp" android:layout_height="96dp"
                        android:layout_gravity="center_horizontal" android:layout_marginTop="12dp"
                        android:indeterminate="false" android:max="100"
                        app:indicatorSize="88dp" app:trackThickness="9dp" app:indicatorColor="@color/gm_teal" app:trackColor="@color/gm_border" />
                    <TextView
                        android:id="@+id/exMomentum"
                        style="@style/RewardBody" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/exMomentumBar" android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp"
                        android:max="100" />
                    <TextView
                        android:id="@+id/exBand"
                        style="@style/RewardBody" />
                    <TextView
                        android:id="@+id/exRecoveryNote"
                        style="@style/RewardBody"
                        android:text="@string/ex_recovery_note" />
                </LinearLayout>
                <LinearLayout style="@style/RewardPanel">
                    <TextView
                        android:id="@+id/exRecommended"
                        style="@style/RewardHeading"
                        android:text="@string/gm_recommendation" />
                    <TextView
                        android:id="@+id/exRecommendationTitle"
                        style="@style/RewardBody" />
                    <TextView
                        android:id="@+id/exRecommendationMeta"
                        style="@style/RewardBody" />
                    <TextView
                        android:id="@+id/exRecommendationReason"
                        style="@style/RewardBody" />
                    <CheckBox
                        android:id="@+id/exUseHealth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:saveEnabled="false"
                        android:text="@string/ar_use_health" android:textColor="@color/gm_ink" />
                    <CheckBox android:id="@+id/exUseBandit"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/cmab_enable" android:textColor="@color/gm_ink" />
                    <TextView style="@style/RewardBody" android:text="@string/cmab_note" />
                    <TextView android:id="@+id/exHealthReason" style="@style/RewardBody" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/exUsual"
                        style="@style/ExerciseButton"
                        android:text="@string/ar_usual" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/exExplain"
                        style="@style/ExerciseButton"
                        android:text="@string/ar_explain" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/exStart" app:backgroundTint="@color/gm_purple" android:textColor="#FFFFFFFF"
                        style="@style/ExerciseButton"
                        android:text="@string/ex_start"
                        android:enabled="false" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/exDiscard"
                        style="@style/ExerciseButton"
                        android:text="@string/ex_discard" />
                </LinearLayout>
                <TextView
                    android:id="@+id/exQuestsTitle"
                    style="@style/RewardHeading"
                    android:text="@string/ex_quests" />
                <TextView style="@style/RewardBody" android:text="@string/gm_quests_note" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/exQuests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
                <LinearLayout style="@style/RewardPanel">
                    <TextView
                        style="@style/RewardHeading"
                        android:text="@string/al_today" />
                    <TextView
                        android:id="@+id/alHomeSummary"
                        style="@style/RewardBody"
                        android:text="@string/al_loading" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/exWearableWorkouts"
                    style="@style/ExerciseButton" android:text="@string/ww_track" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exPath"
                    style="@style/ExerciseButton"
                    android:text="@string/ex_path" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exQuick"
                    style="@style/ExerciseButton"
                    android:text="@string/ex_quick" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exProgress"
                    style="@style/ExerciseButton"
                    android:text="@string/ex_progress" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exAchievements"
                    style="@style/ExerciseButton"
                    android:text="@string/ex_achievements" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
