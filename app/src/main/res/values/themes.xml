<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Light Mode -->
    <style name="Base.Theme.FitnessBalance" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary brand color. This will be used for buttons and other key UI elements. -->
        <!-- We'll use your 'primary_color' (#4CAF50 - Green) for this. -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. Used for less prominent UI elements. -->
        <!-- We'll use your 'purple_500' for this. -->
        <item name="colorSecondary">@color/purple_500</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color. This makes the bar above your app match the primary color. -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>

        <!-- You can add more customizations here later. -->

    </style>

    <style name="Theme.FitnessBalance" parent="Base.Theme.FitnessBalance" />
</resources>