rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function noPassword(data) { return !data.keys().hasAny(['password', 'passwordHash', 'confirmPassword']); }
  function protectedFields() { return ['totalXp','level','lastRecordId','metGoalWeeks','achievementIds','feedbackCount','lastWorkoutAt','lastDiscomfortAt','lastDifficulty','lastFeeling','weeklyCounts','weeklyCategories']; }
  function freshRecord(uid,id) {
   let ref = /databases/$(database)/documents/users/$(uid)/workoutRecords/$(id);
   return !exists(ref) && existsAfter(ref) && getAfter(ref).data.completedAt == request.time;
  }
  function atomicAward(uid) {
   let d = request.resource.data;
   let id = d.lastRecordId;
   let r = /databases/$(database)/documents/users/$(uid)/workoutRecords/$(id);
   return id is string && freshRecord(uid,id)
    && d.totalXp is int && d.totalXp >= 0 && d.totalXp <= 1000000000
    && getAfter(r).data.totalXpAfter == d.totalXp
    && getAfter(r).data.xpEarned == d.totalXp - (exists(/databases/$(database)/documents/users/$(uid)) ? resource.data.get('totalXp',0) : 0)
    && d.level == int(d.totalXp / 100) + 1;
  }
  function freshWearableReward(uid,id) {
   let ref = /databases/$(database)/documents/users/$(uid)/wearableWorkoutRewards/$(id);
   return id is string && !exists(ref) && existsAfter(ref) && getAfter(ref).data.createdAt == request.time;
  }
  function atomicWearableAward(uid) {
   let d = request.resource.data;
   let id = d.get('lastRecordId','');
   let reward = getAfter(/databases/$(database)/documents/users/$(uid)/wearableWorkoutRewards/$(id)).data;
   return freshWearableReward(uid,id)
    && d.diff(resource.data).affectedKeys().hasOnly(['lastRecordId','totalXp','level','metGoalWeeks','achievementIds','lastWorkoutAt'])
    && d.totalXp is int && d.totalXp >= 0 && d.totalXp <= 1000000000
    && d.totalXp == reward.totalXpAfter && d.totalXp == resource.data.get('totalXp',0) + reward.xpEarned
    && d.level == int(d.totalXp / 100) + 1
    && d.metGoalWeeks is list && d.metGoalWeeks.toSet() == (reward.weeklyBonusXp == 30 ? resource.data.get('metGoalWeeks',[]).toSet().union([reward.week].toSet()) : resource.data.get('metGoalWeeks',[]).toSet())
    && d.achievementIds is list && d.achievementIds.toSet() == resource.data.get('achievementIds',[]).toSet().union(reward.unlocked.toSet())
    && d.lastWorkoutAt == (resource.data.get('lastWorkoutAt',timestamp.value(0)) > timestamp.value(reward.endedAtMillis) ? resource.data.lastWorkoutAt : timestamp.value(reward.endedAtMillis));
  }
  function wearableWeekBonus(uid,d) {
   let weekRef = /databases/$(database)/documents/users/$(uid)/exerciseWeeks/$(d.week);
   let profile = get(/databases/$(database)/documents/users/$(uid)).data;
   let prior = exists(weekRef) && get(weekRef).data.get('bonusAwarded',false);
   return d.weeklyCompleted >= d.weeklyTarget && !prior && !profile.get('metGoalWeeks',[]).hasAny([d.week]) ? 30 : 0;
  }
  function wearableWeekUpdate(uid,id,week) {
   let award = getAfter(/databases/$(database)/documents/users/$(uid)/wearableWorkoutRewards/$(id)).data;
   let ref = /databases/$(database)/documents/users/$(uid)/exerciseWeeks/$(week);
   let before = exists(ref) ? get(ref).data : {};
   let d = request.resource.data;
   return freshWearableReward(uid,id) && award.week == week
    && d.completed == award.weeklyCompleted && d.target == award.weeklyTarget
    && d.categories is list && d.categories.toSet() == before.get('categories',[]).toSet().union([award.category].toSet())
    && d.bonusAwarded == (before.get('bonusAwarded',false) || award.weeklyBonusXp > 0 || get(/databases/$(database)/documents/users/$(uid)).data.get('metGoalWeeks',[]).hasAny([week]));
  }
  function wearableAchievement(uid,id,record) {
   let award = getAfter(/databases/$(database)/documents/users/$(uid)/wearableWorkoutRewards/$(record)).data;
   let before = get(/databases/$(database)/documents/users/$(uid)).data;
   let after = getAfter(/databases/$(database)/documents/users/$(uid)).data;
   let categories = getAfter(/databases/$(database)/documents/users/$(uid)/exerciseWeeks/$(award.week)).data.categories;
   return freshWearableReward(uid,record) && award.unlocked.hasAny([id])
    && (id == 'first_step'
     || (id == 'routine_builder' && after.metGoalWeeks.size() >= 2)
     || (id == 'welcome_back' && before.get('lastWorkoutAt',timestamp.value(0)) > timestamp.value(0) && timestamp.value(award.startedAtMillis) >= before.lastWorkoutAt + duration.value(7,'d'))
     || (id == 'balanced_week' && categories.hasAll(['strength','mobility','recovery'])));
  }
  function wearableUnlockProof(uid,award,unlocked,id) {
   let ref = /databases/$(database)/documents/users/$(uid)/unlockedAchievements/$(id);
   return !unlocked.hasAny([id]) || (!exists(ref) && getAfter(ref).data.recordId == award && getAfter(ref).data.unlockedAt == request.time);
  }
  function validWearableReward(uid,id) {
   let d = request.resource.data;
   let userRef = /databases/$(database)/documents/users/$(uid);
   let profile = get(userRef).data;
   let weekRef = /databases/$(database)/documents/users/$(uid)/exerciseWeeks/$(d.week);
   let dayRef = /databases/$(database)/documents/users/$(uid)/wearableRewardDays/$(d.day);
   let receipt = getAfter(/databases/$(database)/documents/users/$(uid)/wearableWorkoutLinks/$(id)).data;
   let count = exists(weekRef) ? get(weekRef).data.get('completed',0) : profile.get('weeklyCounts',{}).get(d.week,0);
   let target = profile.get('weeklyWorkoutTarget',3);
   return id.matches('^wearable_[0-9a-f]{64}$')
    && d.keys().hasOnly(['source','activity','entryId','day','week','category','baseXp','questXp','weeklyBonusXp','xpEarned','weeklyCompleted','weeklyTarget','totalXpAfter','newDayCredit','unlocked','ruleVersion','durationSeconds','startedAtMillis','endedAtMillis','createdAt'])
    && d.entryId == id && receipt.entryId == id && receipt.date == d.day
    && d.source == 'health_connect' && d.activity is string && d.activity.size() > 0 && d.activity.size() <= 100 && d.ruleVersion == 'wearable-rewards-v1'
    && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.week is string && d.week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.startedAtMillis is int && d.endedAtMillis is int && d.startedAtMillis >= request.time.toMillis() - 604800000
    && d.endedAtMillis <= request.time.toMillis() && d.endedAtMillis - d.startedAtMillis >= 300000 && d.endedAtMillis - d.startedAtMillis <= 86400000
    && d.durationSeconds == int((d.endedAtMillis - d.startedAtMillis) / 1000)
    && d.category in ['cardio','strength','mobility','mixed']
    && d.newDayCredit is bool && d.newDayCredit == !exists(dayRef)
    && (!d.newDayCredit || getAfter(dayRef).data.awardId == id)
    && d.baseXp == (d.newDayCredit ? 20 : 0)
    && d.questXp == ((!exists(/databases/$(database)/documents/users/$(uid)/questProgress/$(d.day + '_planned')) ? 5 : 0) + (!exists(/databases/$(database)/documents/users/$(uid)/questProgress/$(d.day + '_minutes')) ? 5 : 0))
    && getAfter(/databases/$(database)/documents/users/$(uid)/questProgress/$(d.day + '_planned')).data.completed == true
    && getAfter(/databases/$(database)/documents/users/$(uid)/questProgress/$(d.day + '_minutes')).data.completed == true
    && d.weeklyCompleted == count + (d.newDayCredit ? 1 : 0)
    && d.weeklyTarget == (target < 1 ? 1 : (target > 7 ? 7 : target))
    && d.weeklyBonusXp == wearableWeekBonus(uid,d)
    && d.xpEarned is int && d.xpEarned == d.baseXp + d.questXp + d.weeklyBonusXp
    && d.totalXpAfter == profile.get('totalXp',0) + d.xpEarned
    && getAfter(userRef).data.totalXp == d.totalXpAfter && getAfter(userRef).data.lastRecordId == id
    && getAfter(weekRef).data.completed == d.weeklyCompleted && getAfter(weekRef).data.lastRecordId == id
    && d.unlocked is list && d.unlocked.size() <= 4 && ['first_step','routine_builder','welcome_back','balanced_week'].hasAll(d.unlocked)
    && wearableUnlockProof(uid,id,d.unlocked,'first_step') && wearableUnlockProof(uid,id,d.unlocked,'routine_builder')
    && wearableUnlockProof(uid,id,d.unlocked,'welcome_back') && wearableUnlockProof(uid,id,d.unlocked,'balanced_week')
    && d.createdAt == request.time;
  }
  function lessonAvailable(uid,path,id) {
   let l = get(/databases/$(database)/documents/workoutPaths/$(path)/lessons/$(id)).data;
   let prerequisite = l.get('prerequisiteLessonId',null);
   return l.active == true && (l.get('standalone',false) == true || prerequisite == null || prerequisite == ''
    || get(/databases/$(database)/documents/users/$(uid)/pathProgress/$(path)).data.bestPercent.get(prerequisite,0) >= 50);
  }
  match /exercises/{id} { allow read: if signedIn(); }
  match /workoutPaths/{path} {
   allow read: if signedIn();
   match /lessons/{lesson} {
    allow read: if signedIn();
    match /workoutExercises/{item} { allow read: if signedIn(); }
   }
  }
  match /quests/{id} { allow read: if signedIn(); }
  match /achievements/{id} { allow read: if signedIn(); }
  // Existing shared food search and owner-scoped barcode data must keep working.
  match /foods/{id} { allow read: if signedIn(); }
  match /users/{uid} {
   allow read: if owner(uid);
   allow create: if owner(uid) && noPassword(request.resource.data)
    && (!request.resource.data.keys().hasAny(protectedFields()) || atomicAward(uid));
   allow update: if owner(uid) && noPassword(request.resource.data)
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields()) || atomicAward(uid) || atomicWearableAward(uid));
   // Dated manual weights and their transaction-maintained private index.
   match /weightLogs/{day} {
    function validWeight() {
     let d = request.resource.data;
     return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && d.keys().hasOnly(['day','weightKg','revision','source','mutationId','updateProfile','updatedAt'])
      && d.day == day && d.weightKg is number && d.weightKg > 0 && d.weightKg <= 300
      && d.revision is int && d.revision > 0 && d.source == 'manual'
      && d.mutationId is string && d.mutationId.size() > 0 && d.mutationId.size() <= 64
      && d.updateProfile is bool && d.updatedAt == request.time;
    }
    function matchingIndex() {
     let index = getAfter(/databases/$(database)/documents/users/$(uid)/weightHistory/state).data;
     return index.updatedAt == request.time && index.entries[day].weightKg == request.resource.data.weightKg
      && index.entries[day].revision == request.resource.data.revision;
    }
    allow read: if owner(uid);
    allow create: if owner(uid) && validWeight() && request.resource.data.revision == 1 && matchingIndex();
    allow update: if owner(uid) && validWeight() && request.resource.data.revision == resource.data.get('revision',1) + 1 && matchingIndex();
    allow delete: if owner(uid)
     && getAfter(/databases/$(database)/documents/users/$(uid)/weightHistory/state).data.updatedAt == request.time
     && !getAfter(/databases/$(database)/documents/users/$(uid)/weightHistory/state).data.entries.keys().hasAny([day]);
   }
   match /weightHistory/{id} {
    allow read: if owner(uid);
    allow create, update: if owner(uid) && id == 'state'
     && request.resource.data.keys().hasOnly(['entries','updatedAt'])
     && request.resource.data.entries is map && request.resource.data.entries.keys().size() <= 5000
     && request.resource.data.updatedAt == request.time;
    allow delete: if owner(uid) && resource.data.entries.keys().size() == 0;
   }
   // Reusable, owner-only snapshots. Nutrition is self-reported, not certified by rules.
   match /savedMeals/{mealId} {
    function validMeal() {
     let d = request.resource.data;
     return d.keys().hasOnly(['name','items','revision','createdAt','updatedAt'])
      && d.name is string && d.name.size() > 0 && d.name.size() <= 80
      && d.items is list && d.items.size() > 0 && d.items.size() <= 25
      && d.revision is int && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    allow read, delete: if owner(uid);
    allow create: if owner(uid) && validMeal() && request.resource.data.revision == 1
     && request.resource.data.createdAt == request.time;
    allow update: if owner(uid) && validMeal()
     && request.resource.data.revision == resource.data.revision + 1
     && request.resource.data.createdAt == resource.data.createdAt
     && request.resource.data.items == resource.data.items;
   }
   match /foodNutrition/{foodId} {
    function validPersonalNutrition() {
     let d = request.resource.data;
     return d.keys().hasOnly(['originalFoodId','food_name','nutrition','nutrition_basis','source_kind','source_database','source_note','nutrition_verification','label_amount','label_unit','label_nutrition','alternativeFoodId','alternativeName','revision','mutationId','updatedAt','confirmedAt'])
      && d.originalFoodId == foodId && d.food_name is string && d.food_name.size() > 0 && d.food_name.size() <= 1000
      && d.nutrition is map && d.nutrition.keys().hasOnly(['energy_kcal','protein_g','carbohydrate_g','fat_g','fiber_g','sodium_mg'])
      && d.nutrition_basis in ['per_100g','per_100ml'] && d.source_kind in ['label','alternative']
      && d.source_note is string && d.source_note.size() > 0 && d.source_note.size() <= 300
      && d.source_database is string && d.nutrition_verification is string
      && d.revision is int && d.mutationId is string && d.mutationId.size() == 36
      && d.updatedAt == request.time && d.confirmedAt == request.time
      && (d.source_kind == 'label'
       ? d.label_amount is number && d.label_amount > 0 && d.label_amount <= 10000 && d.label_unit in ['g','ml'] && d.label_nutrition is map
        && d.nutrition_verification == 'user_entered'
        && (d.label_unit == 'g' ? d.nutrition_basis == 'per_100g' : d.nutrition_basis == 'per_100ml')
       : d.alternativeFoodId is string && d.alternativeFoodId.size() > 0 && d.alternativeName is string && d.nutrition_verification == 'approximate_substitution');
    }
    allow read, delete: if owner(uid);
    allow create: if owner(uid) && validPersonalNutrition() && request.resource.data.revision == 1;
    allow update: if owner(uid) && validPersonalNutrition() && request.resource.data.revision == resource.data.revision + 1;
   }
   match /recipes/{recipeId} {
    function validRecipe() {
     let d = request.resource.data;
     return d.keys().hasOnly(['name','items','yieldServings','revision','mutationId','createdAt','updatedAt'])
      && d.name is string && d.name.size() > 0 && d.name.size() <= 80
      && d.items is list && d.items.size() > 0 && d.items.size() <= 25
      && d.yieldServings is number && d.yieldServings > 0 && d.yieldServings <= 10000
      && d.revision is int && d.mutationId is string && d.mutationId.size() == 36
      && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    allow read, delete: if owner(uid);
    allow create: if owner(uid) && validRecipe() && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
    allow update: if owner(uid) && validRecipe() && request.resource.data.revision == resource.data.revision + 1
     && request.resource.data.createdAt == resource.data.createdAt;
   }
   match /personalServings/{servingId} {
    function validServing() {
     let d = request.resource.data;
     return d.keys().hasOnly(['name','foodKey','amount','unit','revision','createdAt','updatedAt'])
      && d.name is string && d.name.size() > 0 && d.name.size() <= 80
      && d.foodKey is string && d.foodKey.size() > 0 && d.foodKey.size() <= 300
      && d.amount is number && d.amount > 0 && d.amount <= 10000 && d.unit in ['g','ml']
      && d.revision is int && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    allow read, delete: if owner(uid);
    allow create: if owner(uid) && validServing() && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
    allow update: if owner(uid) && validServing() && request.resource.data.revision == resource.data.revision + 1
     && request.resource.data.foodKey == resource.data.foodKey && request.resource.data.unit == resource.data.unit
     && request.resource.data.createdAt == resource.data.createdAt;
   }
   // Immutable receipts make a retried multi-food diary insertion a no-op.
   match /savedMealLogs/{operation} {
    allow read: if owner(uid);
    allow create: if owner(uid)
     && operation.matches('^[0-9a-f-]{36}$')
     && request.resource.data.keys().hasOnly(['date','mealId','entryCount','createdAt'])
     && request.resource.data.date is string
     && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
     && request.resource.data.mealId is string && request.resource.data.mealId.size() > 0
     && request.resource.data.entryCount is int && request.resource.data.entryCount > 0 && request.resource.data.entryCount <= 25
     && request.resource.data.createdAt == request.time;
   }
   match /foodLogs/{day} { allow read, write: if owner(uid); }
   match /wearableWorkoutRewards/{id} {
    allow read: if owner(uid);
    allow create: if owner(uid) && validWearableReward(uid,id);
   }
   match /wearableRewardDays/{day} {
    allow read: if owner(uid);
    allow create: if owner(uid)
     && request.resource.data.keys().hasOnly(['day','week','awardId','createdAt'])
     && request.resource.data.day == day && request.resource.data.createdAt == request.time
     && freshWearableReward(uid,request.resource.data.awardId)
     && getAfter(/databases/$(database)/documents/users/$(uid)/wearableWorkoutRewards/$(request.resource.data.awardId)).data.day == day
     && getAfter(/databases/$(database)/documents/users/$(uid)/wearableWorkoutRewards/$(request.resource.data.awardId)).data.week == request.resource.data.week;
   }
   // Confirmation receipts survive deletion of an activity log, preventing re-import.
   match /wearableWorkoutLinks/{id} {
    allow read: if owner(uid);
    allow create: if owner(uid) && id.matches('^wearable_[0-9a-f]{64}$')
     && request.resource.data.keys().hasOnly(['date','entryId','createdAt'])
     && request.resource.data.date is string
     && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
     && request.resource.data.entryId == id && request.resource.data.createdAt == request.time;
   }
   match /exerciseLogs/{day} { allow read, write: if owner(uid); }
   match /dailyData/{day} { allow read, write: if owner(uid); }
   match /barcodeFoods/{barcode} { allow read, write: if owner(uid); }
   match /workoutSessions/{id} {
    allow read: if owner(uid);
    allow create: if owner(uid)
     && request.resource.data.keys().hasOnly(['pathId','lessonId','plannedExercises','startedAt'])
     && request.resource.data.pathId is string && request.resource.data.lessonId is string
     && request.resource.data.plannedExercises is int && request.resource.data.plannedExercises > 0 && request.resource.data.plannedExercises <= 64
     && request.resource.data.startedAt == request.time
     && lessonAvailable(uid,request.resource.data.pathId,request.resource.data.lessonId);
   }
   match /workoutRecords/{id} {
    allow read: if owner(uid);
    allow create: if owner(uid) && validRecord(uid,id);
   }
   match /pathProgress/{path} {
    allow read: if owner(uid);
    allow create, update: if owner(uid)
     && request.resource.data.keys().hasOnly(['completionCounts','bestPercent','bestStars','updatedAt'])
     && request.resource.data.completionCounts is map && request.resource.data.bestPercent is map && request.resource.data.bestStars is map
     && request.resource.data.updatedAt == request.time
     && freshRecord(uid,getAfter(/databases/$(database)/documents/users/$(uid)).data.lastRecordId);
   }
   match /exerciseWeeks/{week} {
    allow read: if owner(uid);
    allow create, update: if owner(uid)
     && request.resource.data.keys().hasOnly(['completed','categories','bonusAwarded','target','lastRecordId','updatedAt'])
     && request.resource.data.completed is int && request.resource.data.completed >= 0
     && request.resource.data.categories is list && request.resource.data.bonusAwarded is bool
     && request.resource.data.target is int && request.resource.data.target >= 1 && request.resource.data.target <= 7
     && request.resource.data.updatedAt == request.time && (freshRecord(uid,request.resource.data.lastRecordId) || wearableWeekUpdate(uid,request.resource.data.lastRecordId,week));
   }
   match /questProgress/{id} {
    allow read: if owner(uid);
    allow create: if owner(uid)
     && request.resource.data.keys().hasOnly(['day','questId','completed','xpEarned','recordId','completedAt'])
     && request.resource.data.questId in ['planned','minutes','feedback']
     && id == request.resource.data.day + '_' + request.resource.data.questId
     && request.resource.data.completed == true && request.resource.data.completedAt == request.time
     && request.resource.data.xpEarned == (request.resource.data.questId == 'feedback' ? 0 : 5)
     && (freshRecord(uid,request.resource.data.recordId) || (request.resource.data.questId in ['planned','minutes']
      && freshWearableReward(uid,request.resource.data.recordId)
      && request.resource.data.day == getAfter(/databases/$(database)/documents/users/$(uid)/wearableWorkoutRewards/$(request.resource.data.recordId)).data.day));
   }
   match /unlockedAchievements/{id} {
    allow read: if owner(uid);
    allow create: if owner(uid)
     && id in ['first_step','routine_builder','path_explorer','welcome_back','honest_reflection','balanced_week']
     && request.resource.data.keys().hasOnly(['recordId','unlockedAt']) && request.resource.data.unlockedAt == request.time
     && (freshRecord(uid,request.resource.data.recordId) || (id in ['first_step','routine_builder','welcome_back','balanced_week']
      && freshWearableReward(uid,request.resource.data.recordId)
      && wearableAchievement(uid,id,request.resource.data.recordId)));
   }
  }
  function validRecord(uid,id) {
   let d = request.resource.data;
   let s = get(/databases/$(database)/documents/users/$(uid)/workoutSessions/$(id)).data;
   let user = getAfter(/databases/$(database)/documents/users/$(uid)).data;
   return d.keys().hasOnly(['pathId','lessonId','lessonName','startedAt','completedAt','plannedExercises','completedExercises','skippedExercises','completionPercentage','durationSeconds','activeDurationSeconds','estimatedCaloriesBurned','xpEarned','starsEarned','difficultyFeedback','feelingFeedback','discomfortReported','firstCompletion','totalXpAfter','weeklyCompleted','weeklyTarget','unlocked','localDay','localWeek','timeZone','category'])
    && d.pathId == s.pathId && d.lessonId == s.lessonId
    && d.lessonName is string && d.startedAt == s.startedAt && d.completedAt == request.time && d.startedAt <= d.completedAt
    && d.plannedExercises == s.plannedExercises
    && d.completedExercises is int && d.completedExercises >= 0 && d.completedExercises <= d.plannedExercises
    && d.skippedExercises is int && d.skippedExercises >= 0 && d.completedExercises + d.skippedExercises <= d.plannedExercises
    && d.completionPercentage is number && d.completionPercentage >= 0 && d.completionPercentage <= 100
    && d.completionPercentage >= d.completedExercises * 100.0 / d.plannedExercises - 0.001
    && d.completionPercentage <= d.completedExercises * 100.0 / d.plannedExercises + 0.001
    && d.durationSeconds is int && d.durationSeconds >= 0 && d.durationSeconds <= 86400
    && d.activeDurationSeconds is int && d.activeDurationSeconds >= 0 && d.activeDurationSeconds <= d.durationSeconds
    && d.estimatedCaloriesBurned is number && d.estimatedCaloriesBurned >= 0 && d.estimatedCaloriesBurned <= 100000
    && d.xpEarned is int && d.xpEarned >= 0 && d.xpEarned <= 77
    && d.difficultyFeedback in ['too_easy','suitable','too_difficult']
    && d.feelingFeedback in ['energized','normal','tired','discomfort']
    && d.discomfortReported == (d.feelingFeedback == 'discomfort')
    && d.starsEarned == (d.completionPercentage < 50 ? 1 : (d.completionPercentage >= 80 && d.difficultyFeedback == 'suitable' ? 3 : 2))
    && d.firstCompletion is bool && d.unlocked is list
    && d.totalXpAfter == user.totalXp && user.lastRecordId == id
    && d.weeklyTarget is int && d.weeklyTarget >= 1 && d.weeklyTarget <= 7
    && d.weeklyCompleted is int && d.weeklyCompleted >= 0;
  }
 }
}
