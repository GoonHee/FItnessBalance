rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function noPassword(data) { return !data.keys().hasAny(['password', 'passwordHash', 'confirmPassword']); }
  function protectedFields() { return ['totalXp','level','lastRecordId','metGoalWeeks','achievementIds','feedbackCount','lastWorkoutAt','lastDiscomfortAt','lastDifficulty','lastFeeling','weeklyCounts','weeklyCategories']; }
  function freshRecord(uid,id) {
   let ref = /databases/$(database)/documents/users/$(uid)/workoutRecords/$(id);
   return !exists(ref) && existsAfter(ref) && getAfter(ref).data.completedAt == request.time;
  }
  function atomicAward(uid) {
   let d = request.resource.data;
   let id = d.lastRecordId;
   let r = /databases/$(database)/documents/users/$(uid)/workoutRecords/$(id);
   return id is string && freshRecord(uid,id)
    && d.totalXp is int && d.totalXp >= 0 && d.totalXp <= 1000000000
    && getAfter(r).data.totalXpAfter == d.totalXp
    && getAfter(r).data.xpEarned == d.totalXp - (exists(/databases/$(database)/documents/users/$(uid)) ? resource.data.get('totalXp',0) : 0)
    && d.level == int(d.totalXp / 100) + 1;
  }
  function lessonAvailable(uid,path,id) {
   let l = get(/databases/$(database)/documents/workoutPaths/$(path)/lessons/$(id)).data;
   let prerequisite = l.get('prerequisiteLessonId',null);
   return l.active == true && (l.get('standalone',false) == true || prerequisite == null || prerequisite == ''
    || get(/databases/$(database)/documents/users/$(uid)/pathProgress/$(path)).data.bestPercent.get(prerequisite,0) >= 50);
  }
  match /exercises/{id} { allow read: if signedIn(); }
  match /workoutPaths/{path} {
   allow read: if signedIn();
   match /lessons/{lesson} {
    allow read: if signedIn();
    match /workoutExercises/{item} { allow read: if signedIn(); }
   }
  }
  match /quests/{id} { allow read: if signedIn(); }
  match /achievements/{id} { allow read: if signedIn(); }
  // Existing shared food search and owner-scoped barcode data must keep working.
  match /foods/{id} { allow read: if signedIn(); }
  match /users/{uid} {
   allow read: if owner(uid);
   allow create: if owner(uid) && noPassword(request.resource.data)
    && (!request.resource.data.keys().hasAny(protectedFields()) || atomicAward(uid));
   allow update: if owner(uid) && noPassword(request.resource.data)
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields()) || atomicAward(uid));
   match /foodLogs/{day} { allow read, write: if owner(uid); }
   match /exerciseLogs/{day} { allow read, write: if owner(uid); }
   match /dailyData/{day} { allow read, write: if owner(uid); }
   match /barcodeFoods/{barcode} { allow read, write: if owner(uid); }
   match /workoutSessions/{id} {
    allow read: if owner(uid);
    allow create: if owner(uid)
     && request.resource.data.keys().hasOnly(['pathId','lessonId','plannedExercises','startedAt'])
     && request.resource.data.pathId is string && request.resource.data.lessonId is string
     && request.resource.data.plannedExercises is int && request.resource.data.plannedExercises > 0 && request.resource.data.plannedExercises <= 64
     && request.resource.data.startedAt == request.time
     && lessonAvailable(uid,request.resource.data.pathId,request.resource.data.lessonId);
   }
   match /workoutRecords/{id} {
    allow read: if owner(uid);
    allow create: if owner(uid) && validRecord(uid,id);
   }
   match /pathProgress/{path} {
    allow read: if owner(uid);
    allow create, update: if owner(uid)
     && request.resource.data.keys().hasOnly(['completionCounts','bestPercent','bestStars','updatedAt'])
     && request.resource.data.completionCounts is map && request.resource.data.bestPercent is map && request.resource.data.bestStars is map
     && request.resource.data.updatedAt == request.time
     && freshRecord(uid,getAfter(/databases/$(database)/documents/users/$(uid)).data.lastRecordId);
   }
   match /exerciseWeeks/{week} {
    allow read: if owner(uid);
    allow create, update: if owner(uid)
     && request.resource.data.keys().hasOnly(['completed','categories','bonusAwarded','target','lastRecordId','updatedAt'])
     && request.resource.data.completed is int && request.resource.data.completed >= 0
     && request.resource.data.categories is list && request.resource.data.bonusAwarded is bool
     && request.resource.data.target is int && request.resource.data.target >= 1 && request.resource.data.target <= 7
     && request.resource.data.updatedAt == request.time && freshRecord(uid,request.resource.data.lastRecordId);
   }
   match /questProgress/{id} {
    allow read: if owner(uid);
    allow create: if owner(uid)
     && request.resource.data.keys().hasOnly(['day','questId','completed','xpEarned','recordId','completedAt'])
     && request.resource.data.questId in ['planned','minutes','feedback']
     && id == request.resource.data.day + '_' + request.resource.data.questId
     && request.resource.data.completed == true && request.resource.data.completedAt == request.time
     && request.resource.data.xpEarned == (request.resource.data.questId == 'feedback' ? 0 : 5)
     && freshRecord(uid,request.resource.data.recordId);
   }
   match /unlockedAchievements/{id} {
    allow read: if owner(uid);
    allow create: if owner(uid)
     && id in ['first_step','routine_builder','path_explorer','welcome_back','honest_reflection','balanced_week']
     && request.resource.data.keys().hasOnly(['recordId','unlockedAt']) && request.resource.data.unlockedAt == request.time
     && freshRecord(uid,request.resource.data.recordId);
   }
  }
  function validRecord(uid,id) {
   let d = request.resource.data;
   let s = get(/databases/$(database)/documents/users/$(uid)/workoutSessions/$(id)).data;
   let user = getAfter(/databases/$(database)/documents/users/$(uid)).data;
   return d.keys().hasOnly(['pathId','lessonId','lessonName','startedAt','completedAt','plannedExercises','completedExercises','skippedExercises','completionPercentage','durationSeconds','activeDurationSeconds','estimatedCaloriesBurned','xpEarned','starsEarned','difficultyFeedback','feelingFeedback','discomfortReported','firstCompletion','totalXpAfter','weeklyCompleted','weeklyTarget','unlocked','localDay','localWeek','timeZone','category'])
    && d.pathId == s.pathId && d.lessonId == s.lessonId
    && d.lessonName is string && d.startedAt == s.startedAt && d.completedAt == request.time && d.startedAt <= d.completedAt
    && d.plannedExercises == s.plannedExercises
    && d.completedExercises is int && d.completedExercises >= 0 && d.completedExercises <= d.plannedExercises
    && d.skippedExercises is int && d.skippedExercises >= 0 && d.completedExercises + d.skippedExercises <= d.plannedExercises
    && d.completionPercentage is number && d.completionPercentage >= 0 && d.completionPercentage <= 100
    && d.completionPercentage >= d.completedExercises * 100.0 / d.plannedExercises - 0.001
    && d.completionPercentage <= d.completedExercises * 100.0 / d.plannedExercises + 0.001
    && d.durationSeconds is int && d.durationSeconds >= 0 && d.durationSeconds <= 86400
    && d.activeDurationSeconds is int && d.activeDurationSeconds >= 0 && d.activeDurationSeconds <= d.durationSeconds
    && d.estimatedCaloriesBurned is number && d.estimatedCaloriesBurned >= 0 && d.estimatedCaloriesBurned <= 100000
    && d.xpEarned is int && d.xpEarned >= 0 && d.xpEarned <= 77
    && d.difficultyFeedback in ['too_easy','suitable','too_difficult']
    && d.feelingFeedback in ['energized','normal','tired','discomfort']
    && d.discomfortReported == (d.feelingFeedback == 'discomfort')
    && d.starsEarned == (d.completionPercentage < 50 ? 1 : (d.completionPercentage >= 80 && d.difficultyFeedback == 'suitable' ? 3 : 2))
    && d.firstCompletion is bool && d.unlocked is list
    && d.totalXpAfter == user.totalXp && user.lastRecordId == id
    && d.weeklyTarget is int && d.weeklyTarget >= 1 && d.weeklyTarget <= 7
    && d.weeklyCompleted is int && d.weeklyCompleted >= 0;
  }
 }
}
