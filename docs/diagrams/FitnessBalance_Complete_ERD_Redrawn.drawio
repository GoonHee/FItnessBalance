llColor=#f0eafa;strokeColor=#475569;"><mxGeometry as="geometry" x="2130" y="1670" width="320" height="240" /></mxCell><mxCell id="weightLogs" value="&lt;b&gt;weightLogs&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;USER-OWNED DOCUMENT&lt;/font&gt;&lt;hr/&gt;date [ID]&lt;br/&gt;day&lt;br/&gt;weightKg&lt;br/&gt;revision" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Times New Roman;fontSize=16;fillColor=#f0eafa;strokeColor=#475569;"><mxGeometry as="geometry" x="1310" y="2100" width="320" height="240" /></mxCell><mxCell id="weightHistory" value="&lt;b&gt;weightHistory&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;USER-OWNED DOCUMENT&lt;/font&gt;&lt;hr/&gt;state [ID]&lt;br/&gt;entries&lt;br/&gt;updatedAt" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Times New Roman;fontSize=16;fillColor=#f0eafa;strokeColor=#475569;"><mxGeometry as="geometry" x="1720" y="2100" width="320" height="240" /></mxCell><mxCell id="legend" value="READING THE DIAGRAM&#10;Pale solid connectors: users 1 → many private documents (weightHistory has at most one state document per user). Green solid: embedded data. Blue dashed: logical identifier/provenance association. Gold dotted: derived summary/index.&#10;ID denotes the document path key. Private collections are nested beneath users/{uid}; they are not independent public tables. Green cards are embedded maps or array entries, not separate collections.&#10;Cardinalities are shown at reference/embedding endpoints. References from quests and achievements can point to a guided record OR a wearable award. Historical references and immutable receipts may remain after source deletion.&#10;This is a logical NoSQL model, not SQL foreign-key enforcement. Key fields are shown; the full field dictionary remains the detailed specification. Health Connect caches and recommendation state stored only on-device are outside this cloud ERD." vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=16;align=left;"><mxGeometry as="geometry" x="40" y="2380" width="3720" height="140" /></mxCell></root></mxGraphModel></diagram></mxfile>