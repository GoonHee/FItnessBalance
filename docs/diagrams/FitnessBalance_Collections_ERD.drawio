try as="geometry" x="1720" y="1240" width="320" height="280" /></mxCell><mxCell id="unlockedAchievements" value="&lt;b&gt;unlockedAchievements&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;USER-OWNED DOCUMENT&lt;/font&gt;&lt;hr/&gt;achievementId [ID] : string&lt;br/&gt;recordId : string&lt;br/&gt;unlockedAt : timestamp" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Times New Roman;fontSize=15;fillColor=#f0eafa;strokeColor=#475569;"><mxGeometry as="geometry" x="2130" y="1240" width="320" height="280" /></mxCell><mxCell id="dailyData" value="&lt;b&gt;dailyData&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;USER-OWNED DOCUMENT&lt;/font&gt;&lt;hr/&gt;date [ID] : string&lt;br/&gt;caloriesConsumed : integer&lt;br/&gt;caloriesBurned : integer&lt;br/&gt;nutrientTotals : map&lt;br/&gt;structuredExerciseContributions : map&lt;br/&gt;exerciseEntryCount : integer" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Times New Roman;fontSize=15;fillColor=#f0eafa;strokeColor=#475569;"><mxGeometry as="geometry" x="1310" y="1670" width="320" height="280" /></mxCell><mxCell id="wearableWorkoutLinks" value="&lt;b&gt;wearableWorkoutLinks&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;USER-OWNED DOCUMENT&lt;/font&gt;&lt;hr/&gt;entryId [ID] : string&lt;br/&gt;date : string&lt;br/&gt;entryId : string&lt;br/&gt;createdAt : timestamp" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Times New Roman;fontSize=15;fillColor=#f0eafa;strokeColor=#475569;"><mxGeometry as="geometry" x="1720" y="1670" width="320" height="280" /></mxCell><mxCell id="wearableRewardDays" value="&lt;b&gt;wearableRewardDays&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;USER-OWNED DOCUMENT&lt;/font&gt;&lt;hr/&gt;date [ID] : string&lt;br/&gt;day : string&lt;br/&gt;week : string&lt;br/&gt;awardId : string" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Times New Roman;fontSize=15;fillColor=#f0eafa;strokeColor=#475569;"><mxGeometry as="geometry" x="2130" y="1670" width="320" height="280" /></mxCell><mxCell id="weightLogs" value="&lt;b&gt;weightLogs&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;USER-OWNED DOCUMENT&lt;/font&gt;&lt;hr/&gt;date [ID] : string&lt;br/&gt;day : string&lt;br/&gt;weightKg : number&lt;br/&gt;revision : integer" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Times New Roman;fontSize=15;fillColor=#f0eafa;strokeColor=#475569;"><mxGeometry as="geometry" x="1310" y="2100" width="320" height="280" /></mxCell><mxCell id="weightHistory" value="&lt;b&gt;weightHistory&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;USER-OWNED DOCUMENT&lt;/font&gt;&lt;hr/&gt;state [ID] : string&lt;br/&gt;entries : map&lt;br/&gt;updatedAt : timestamp" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Times New Roman;fontSize=15;fillColor=#f0eafa;strokeColor=#475569;"><mxGeometry as="geometry" x="1720" y="2100" width="320" height="280" /></mxCell><mxCell id="legend" value="READING THIS COLLECTIONS-BASED ERD&#10;Each entity represents a collection/subcollection document structure. [ID] is the document path key; ordinary fields are attributes, not relationships.&#10;foods.nutrition, foodLogs.foodItems and exerciseLogs.exercises are map/array attributes, not collection entities. Nested IDs such as foodItems[].foodId are shown as attribute paths, not extra entities.&#10;Pale solid lines show user ownership and path/subcollection nesting. Blue dashed lines show logical identifier associations; endpoint labels give logical cardinalities. Weight history has at most one state index per user.&#10;Food catalogue/recipe/saved-meal associations with dated foodLogs are many-to-many through embedded entry identifiers. A shared date is interpreted within the same user. recordId has alternative guided/wearable sources.&#10;Firestore does not enforce SQL foreign keys or cascading deletion. Optional historical identifiers may outlive a removed source. Key attributes are shown; the data dictionary supplies the complete fields. Local health caches are outside this cloud model." vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=16;align=left;"><mxGeometry as="geometry" x="40" y="2460" width="3720" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>